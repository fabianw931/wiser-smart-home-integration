# Copy to .env (never commit it) and run: chmod 600 .env
# Shell variables take precedence over this file.

# --- Gateway: connects automatically every time the app starts ---
WISER_GATEWAY_HOST=192.168.1.123
WISER_GATEWAY_TOKEN=

# --- Optional: web app port (localhost only) ---
# PORT=3000

# --- Optional: Home Assistant integration ---
# 32-256 characters from A-Z a-z 0-9 _ -  (generate: openssl rand -hex 32)
# WISER_INTEGRATION_TOKEN=
# Set to 1 only for a supervised test; lets Home Assistant send commands.
# WISER_INTEGRATION_CONTROL=0
# HTTPS listener (npm run start:integration)
# WISER_TLS_CERT=/path/to/cert.pem
# WISER_TLS_KEY=/path/to/key.pem
# WISER_API_BIND=127.0.0.1
# WISER_API_PORT=3443
