# Copy to .env (never commit it) and run: chmod 600 .env
# Shell variables take precedence over this file.

# --- Gateway: connects automatically every time the app starts ---
WISER_GATEWAY_HOST=192.168.1.123
WISER_GATEWAY_TOKEN=

# --- Optional: web app port (localhost only) ---
# PORT=3000

# --- Optional: Home Assistant integration (started together with the app by `npm start`) ---
# Setting the token switches the integration API on. 32-256 characters from A-Z a-z 0-9 _ -  (generate: openssl rand -hex 32)
# WISER_INTEGRATION_TOKEN=
# Read-only unless this is 1. Enable it only for a supervised test: it lets Home Assistant send commands.
# WISER_INTEGRATION_CONTROL=0
# Plain HTTP on a trusted LAN (what Home Assistant's "Use HTTPS" off expects). The bind address is REQUIRED in this mode:
# use this computer's LAN address, or 0.0.0.0 for all interfaces. The token then travels unencrypted.
# WISER_API_TLS=0
# WISER_API_BIND=192.168.1.50
# WISER_API_PORT=3443
# Seconds between gateway reads for Home Assistant snapshots (15-3600). Home Assistant polling never adds gateway requests.
# WISER_SNAPSHOT_TTL=60
# Optional HTTPS instead (leave WISER_API_TLS unset): needs a certificate Home Assistant can verify.
# WISER_TLS_CERT=/path/to/cert.pem
# WISER_TLS_KEY=/path/to/key.pem
